{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "xyz.mechardo3d.ds2000",
  "productName": "DS2000",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": []
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "system-tray": {}
  },
  "bundle": {
    "icon": [
      "icons/ds2000-logo.ico"
    ],
    "targets": [
      "msi"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      }
    },
    "publisher": "Mechardo Labs"
  }
}
